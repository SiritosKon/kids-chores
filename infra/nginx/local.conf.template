server {
  listen 80;
  server_name _;
  absolute_redirect off;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  set $api http://api:3000;
  set $notifications http://notifications:3001;

  location = / {
    return 302 /kids-chores/;
  }

  location /kids-chores/ {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /kids-chores/index.html;
  }

  location /v1/notifications/ {
    proxy_pass $notifications;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /v1/ {
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
