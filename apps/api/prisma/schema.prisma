generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

model Outbox {
  id         String    @id @db.Uuid
  type       String
  version    Int
  familyId   String?   @map("family_id") @db.Uuid
  payload    Json
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(3)

  @@index([sentAt, occurredAt])
  @@map("outbox")
  @@schema("core")
}

enum MembershipRole {
  owner
  parent

  @@map("membership_role")
  @@schema("core")
}

model User {
  id           String        @id @db.Uuid
  name         String?       @db.VarChar(40)
  pinHash      Json?         @map("pin_hash")
  passwordHash String?       @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  authAccounts AuthAccount[]
  passkeys     Passkey[]
  memberships  Membership[]
  devices      Device[]
  contacts     UserContact[]
  invitesSent  FamilyInvite[]
  joinRequests JoinRequest[]

  @@map("users")
  @@schema("core")
}

model AuthAccount {
  id          String   @id @db.Uuid
  provider    String
  subjectHash String   @map("subject_hash")
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectHash])
  @@index([userId])
  @@map("auth_accounts")
  @@schema("core")
}

model Passkey {
  id         String    @id
  userId     String    @map("user_id") @db.Uuid
  publicKey  Bytes     @map("public_key")
  counter    BigInt
  transports String[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
  @@schema("core")
}

model Family {
  id                 String              @id @db.Uuid
  timeZone           String?             @map("time_zone")
  lastChangeNumber   BigInt              @default(0) @map("last_change_number")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships        Membership[]
  devices            Device[]
  records            FamilyRecord[]
  processedMutations ProcessedMutation[]
  invites            FamilyInvite[]
  joinRequests       JoinRequest[]
  media              Media[]

  @@map("families")
  @@schema("core")
}

model Membership {
  userId    String         @map("user_id") @db.Uuid
  familyId  String         @map("family_id") @db.Uuid
  role      MembershipRole @default(parent)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, familyId])
  @@unique([userId])
  @@index([familyId])
  @@map("memberships")
  @@schema("core")
}

enum ContactKind {
  email
  phone

  @@map("contact_kind")
  @@schema("core")
}

model UserContact {
  kind      ContactKind
  hash      String
  owned     Boolean     @default(false)
  userId    String      @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kind, hash])
  @@index([userId])
  @@map("user_contacts")
  @@schema("core")
}

model FamilyInvite {
  id        String   @id @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  invitedBy String   @map("invited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter   User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_invites")
  @@schema("core")
}

model JoinRequest {
  id        String   @id @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("join_requests")
  @@schema("core")
}

model Device {
  id         String   @id @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("devices")
  @@schema("core")
}

model FamilyRecord {
  familyId       String    @map("family_id") @db.Uuid
  kind           String
  id             String
  data           Json
  fieldChangedAt Json      @map("field_changed_at")
  changeNumber   BigInt    @map("change_number")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([familyId, kind, id])
  @@index([familyId, changeNumber])
  @@map("records")
  @@schema("core")
}

model ProcessedMutation {
  familyId   String   @map("family_id") @db.Uuid
  mutationId String   @map("mutation_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([familyId, mutationId])
  @@map("processed_mutations")
  @@schema("core")
}

model Media {
  id        String   @id @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("media")
  @@schema("core")
}
