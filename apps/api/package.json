{
  "name": "@kids-chores/api",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "prisma generate && prisma migrate deploy && vitest run -c vitest.integration.config.ts",
    "dev": "nest start --watch --env-file .env",
    "start": "node dist/main.js",
    "relay": "node dist/relay.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.2",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@kids-chores/contracts": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "^13.3.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
